# Paid Apple Developer Program only. A free Apple ID cannot notarize.
#
# Copy to .env and fill in values after enrollment. Do not commit .env.

# PROXYLENS_SIGN_IDENTITY=Developer ID Application: Example (TEAMID)

# Apple ID + app-specific password (APPLE_TEAM_ID is required for this path):
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Or App Store Connect API key (team is inferred from the key; APPLE_TEAM_ID is not used):
# APPLE_API_KEY_PATH=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
